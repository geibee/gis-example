{
  "name": "@web-gis/feedback-plugin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/feedback-plugin.js",
  "module": "./dist/feedback-plugin.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/feedback-plugin.js"
    },
    "./styles.css": "./dist/styles.css",
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "import": "./dist/feedback-plugin.js"
    }
  },
  "publishConfig": {
    "access": "restricted"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "generate:contracts": "openapi-typescript ../../apps/api/openapi.yaml -o src/contracts/generated.ts"
  },
  "dependencies": {
    "@feedback/contracts": "file:../../vendor/feedback-sdk/feedback-contracts-1.0.0-alpha.1.tgz",
    "@feedback/core": "file:../../vendor/feedback-sdk/feedback-core-1.0.0-alpha.1.tgz",
    "html-to-image": "1.11.13"
  },
  "peerDependencies": {
    "@tanstack/react-query": ">=5.0.0 <6",
    "maplibre-gl": ">=5.0.0 <6",
    "react": ">=18.0.0 <20",
    "react-dom": ">=18.0.0 <20"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "jsdom": "29.1.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "4.1.9"
  }
}
