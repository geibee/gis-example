{
  "name": "@feedback/maplibre",
  "version": "1.0.0-alpha.1",
  "description": "MapLibre向けフィードバックtarget変換とpin lifecycle adapter",
  "private": true,
  "type": "module",
  "files": ["dist", "README.md", "CHANGELOG.md"],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": { "access": "restricted" },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@feedback/contracts": "1.0.0-alpha.1",
    "@feedback/core": "1.0.0-alpha.1"
  },
  "peerDependencies": {
    "maplibre-gl": ">=5.0.0 <6"
  },
  "devDependencies": {
    "maplibre-gl": "^5.24.0",
    "typescript": "^5.6.3",
    "vitest": "4.1.9"
  }
}
