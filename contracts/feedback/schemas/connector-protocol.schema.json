{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://feedback.example/schemas/connector-protocol.v1.json",
  "title": "FeedbackConnectorProtocolV1",
  "oneOf": [
    { "$ref": "#/$defs/manifest" },
    { "$ref": "#/$defs/deliveryRequest" },
    { "$ref": "#/$defs/deliveryResult" }
  ],
  "$defs": {
    "protocolVersion": {
      "const": "1"
    },
    "compatibleProtocolVersions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "contains": { "const": "1" },
      "items": { "type": "string", "pattern": "^[1-9][0-9]*$" }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "protocolVersion",
        "compatibleProtocolVersions",
        "connectorKey",
        "displayName",
        "supportedEvents",
        "healthPath"
      ],
      "properties": {
        "kind": { "const": "manifest" },
        "protocolVersion": { "$ref": "#/$defs/protocolVersion" },
        "compatibleProtocolVersions": { "$ref": "#/$defs/compatibleProtocolVersions" },
        "connectorKey": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,99}$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 200 },
        "supportedEvents": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "feedback.thread.created.v1",
              "feedback.message.created.v1",
              "feedback.thread.resolved.v1",
              "feedback.thread.reopened.v1"
            ]
          }
        },
        "healthPath": { "type": "string", "format": "uri-reference", "pattern": "^/", "maxLength": 500 }
      }
    },
    "deliveryRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "protocolVersion",
        "deliveryId",
        "eventId",
        "destinationRef",
        "occurredAt",
        "event"
      ],
      "properties": {
        "kind": { "const": "delivery-request" },
        "protocolVersion": { "$ref": "#/$defs/protocolVersion" },
        "deliveryId": { "type": "string", "format": "uuid" },
        "eventId": { "type": "string", "format": "uuid" },
        "destinationRef": { "type": "string", "minLength": 1, "maxLength": 200 },
        "occurredAt": { "type": "string", "format": "date-time" },
        "event": {
          "allOf": [
            { "$ref": "webhook-event.schema.json" },
            { "not": { "required": ["evidenceUrl"] } }
          ]
        }
      }
    },
    "deliveryResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "protocolVersion", "deliveryId", "status", "receivedAt"],
      "properties": {
        "kind": { "const": "delivery-result" },
        "protocolVersion": { "$ref": "#/$defs/protocolVersion" },
        "deliveryId": { "type": "string", "format": "uuid" },
        "status": { "enum": ["accepted", "duplicate"] },
        "receivedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
