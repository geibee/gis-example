{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://feedback.example/schemas/application-manifest.v1.json",
  "title": "FeedbackApplicationManifestV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "applicationKey", "displayName", "manifestVersion", "routes"],
  "properties": {
    "schemaVersion": { "const": "1" },
    "applicationKey": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,62}$"
    },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 200 },
    "manifestVersion": { "type": "string", "minLength": 1, "maxLength": 100 },
    "routes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pageKey", "template", "label"],
        "properties": {
          "pageKey": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$",
            "maxLength": 100
          },
          "template": {
            "type": "string",
            "pattern": "^/(?:[^/?#]+(?:/[^/?#]+)*)?$",
            "maxLength": 500
          },
          "label": { "type": "string", "minLength": 1, "maxLength": 200 },
          "group": { "type": "string", "minLength": 1, "maxLength": 100 },
          "parameters": {
            "type": "object",
            "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": ["persistence"],
              "properties": {
                "persistence": { "enum": ["store", "hash", "discard"] }
              }
            }
          },
          "queryParameters": {
            "type": "object",
            "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$" },
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": ["persistence"],
              "properties": {
                "persistence": { "enum": ["store", "hash", "discard"] }
              }
            }
          },
          "aliases": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "string",
              "pattern": "^/(?:[^/?#]+(?:/[^/?#]+)*)?$",
              "maxLength": 500
            }
          }
        }
      }
    }
  }
}
