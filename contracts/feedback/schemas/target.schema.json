{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://feedback.example/schemas/target.v1.json",
  "title": "FeedbackTargetV1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "kind", "elementKey", "relativeX", "relativeY"],
      "properties": {
        "schemaVersion": { "const": "1" },
        "kind": { "const": "ui-element" },
        "elementKey": { "type": "string", "minLength": 1, "maxLength": 200 },
        "relativeX": { "type": "number", "minimum": 0, "maximum": 1 },
        "relativeY": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "kind", "relativeX", "relativeY"],
      "properties": {
        "schemaVersion": { "const": "1" },
        "kind": { "const": "screen-position" },
        "relativeX": { "type": "number", "minimum": 0, "maximum": 1 },
        "relativeY": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "kind", "provider", "sourceKey", "featureKey", "longitude", "latitude"],
      "properties": {
        "schemaVersion": { "const": "1" },
        "kind": { "const": "map-feature" },
        "provider": { "const": "maplibre" },
        "sourceKey": { "type": "string", "minLength": 1, "maxLength": 200 },
        "sourceLayer": { "type": "string", "minLength": 1, "maxLength": 200 },
        "featureKey": { "type": "string", "minLength": 1, "maxLength": 200 },
        "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
        "latitude": { "type": "number", "minimum": -90, "maximum": 90 }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "kind", "longitude", "latitude"],
      "properties": {
        "schemaVersion": { "const": "1" },
        "kind": { "const": "map-position" },
        "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
        "latitude": { "type": "number", "minimum": -90, "maximum": 90 }
      }
    }
  ]
}
