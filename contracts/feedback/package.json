{
  "name": "@feedback/contracts",
  "version": "1.0.0-alpha.1",
  "description": "フィードバックサービス v1 の OpenAPI、JSON Schema、TypeScript 契約",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "openapi.yaml",
    "token-exchange.openapi.yaml",
    "schemas",
    "README.md",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./openapi.yaml": "./openapi.yaml",
    "./token-exchange.openapi.yaml": "./token-exchange.openapi.yaml",
    "./schemas/*": "./schemas/*"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "scripts": {
    "generate": "openapi-typescript openapi.yaml -o src/generated.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "@types/node": "26.1.0",
    "ajv": "8.20.0",
    "ajv-formats": "2.1.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.6.3",
    "vitest": "4.1.9"
  }
}
