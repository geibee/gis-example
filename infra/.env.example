# infra/.env.example — ローカル開発 (Docker Compose / Podman Compose) 用の資格情報テンプレート
#
#   cp infra/.env.example infra/.env
#
# でコピーしてから `docker compose -f infra/docker-compose.yml up --build`
# または `podman compose -f infra/docker-compose.yml up --build` を実行する。
# 実 .env は gitignore 済み。値を変えても動くが、ここの既定値はローカル開発専用の
# 弱い資格情報であり、本番では一切使わないこと。
# 本番のシークレットの正本は AWS Secrets Manager (docs/environment-variables.md 参照)。

# PostgreSQL (postgres / seed / martin / api / worker-gis が共有)
POSTGRES_DB=gis
POSTGRES_USER=gis
POSTGRES_PASSWORD=gis

# Feedback Service本体は https://github.com/geibee/feedback-system のComposeで起動する。
# Web GISはブラウザから独立サービスへ接続し、manifestをログイン時に自動同期する。
#VITE_FEEDBACK_API_BASE=http://localhost:8090/feedback/v1
#VITE_FEEDBACK_ADMIN_URL=http://localhost:5174/
#VITE_FEEDBACK_APPLICATION_KEY=web-gis
#VITE_FEEDBACK_ENVIRONMENT_KEY=local

# Keycloak bootstrap admin (管理コンソール http://localhost:8081)
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin

# アップロードの保存先 (docs/environment-variables.md 参照)。
# 既定 local はホスト volume 共有 (従来動作)。S3 経路を試す場合は s3 にして
# `docker compose` または `podman compose` に `--profile s3` を付けてMinIOごと起動する
#UPLOAD_STORAGE=s3
#S3_BUCKET=gis-uploads
#S3_REGION=us-east-1

# MinIO (--profile s3 のときのみ使用)。api / worker の AWS 認証情報としても配線される
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio-secret

# ジョブ実行基盤 (issue #24、docs/jobs-architecture.md 参照)。
# 既定 (未設定) は従来どおり polling + API 内蔵の分析ランナー。SQS 経路を試す場合は
# 下 2 行を有効にして `docker compose` または `podman compose` に `--profile sqs` を付けて起動する
# で ElasticMQ と analysis-worker を同時に起動する
#JOB_QUEUE_MODE=sqs
#ANALYSIS_RUNNER_MODE=external

# プロトタイプレビュー通知 (docs/review-notifications.md)。すべて未設定なら外部配信は無効。
# Webhook URL / token は実 .env にのみ置き、このテンプレートへ実値をコミットしない
#REVIEW_EMAIL_FROM=review@example.com
#REVIEW_TEAMS_WEBHOOK_URL=https://example.invalid/teams-webhook
#REVIEW_ISSUE_WEBHOOK_URL=https://example.invalid/issue-webhook
#REVIEW_ISSUE_WEBHOOK_TOKEN=replace-in-infra-dot-env

# ホスト側ポートが競合する場合のみ変更する
#POSTGRES_HOST_PORT=5432
#FEEDBACK_POSTGRES_HOST_PORT=5433
#FEEDBACK_SERVICE_HOST_PORT=8090
#FEEDBACK_ADMIN_HOST_PORT=5174
#MARTIN_HOST_PORT=3000
#WEB_HOST_PORT=5173
# WEB_HOST_PORTを変える場合はTileJSONの公開オリジンも同じ値へ変更する
#API_PUBLIC_URL=http://localhost:5173
