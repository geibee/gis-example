# infra/.env.example — ローカル開発 (docker compose) 用の資格情報テンプレート
#
#   cp infra/.env.example infra/.env
#
# でコピーしてから `docker compose -f infra/docker-compose.yml up --build` する。
# 実 .env は gitignore 済み。値を変えても動くが、ここの既定値はローカル開発専用の
# 弱い資格情報であり、本番では一切使わないこと。
# 本番のシークレットの正本は AWS Secrets Manager (docs/environment-variables.md 参照)。

# PostgreSQL (postgres / seed / martin / api / worker-gis が共有)
POSTGRES_DB=gis
POSTGRES_USER=gis
POSTGRES_PASSWORD=gis

# Keycloak bootstrap admin (管理コンソール http://localhost:8081)
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin

# アップロードの保存先 (docs/environment-variables.md 参照)。
# 既定 local はホスト volume 共有 (従来動作)。S3 経路を試す場合は s3 にして
# `docker compose -f infra/docker-compose.yml --profile s3 up --build` で MinIO ごと起動する
#UPLOAD_STORAGE=s3
#S3_BUCKET=gis-uploads
#S3_REGION=us-east-1

# MinIO (--profile s3 のときのみ使用)。api / worker の AWS 認証情報としても配線される
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio-secret

# ジョブ実行基盤 (issue #24、docs/jobs-architecture.md 参照)。
# 既定 (未設定) は従来どおり polling + API 内蔵の分析ランナー。SQS 経路を試す場合は
# 下 2 行を有効にして `docker compose -f infra/docker-compose.yml --profile sqs up --build`
# で ElasticMQ と analysis-worker を同時に起動する
#JOB_QUEUE_MODE=sqs
#ANALYSIS_RUNNER_MODE=external

# ホスト側ポートが競合する場合のみ変更する
#POSTGRES_HOST_PORT=5432
#WEB_HOST_PORT=5173

# Feedback system (Redmine正本、localhost開発専用)。API keyと署名鍵はdev用の弱い値。
# 本番ではSecrets Managerから別値を注入し、VITE_*やSPA bundleへ渡さない。
FEEDBACK_REDMINE_DB_PASSWORD=feedback-redmine-local
FEEDBACK_REDMINE_SECRET_KEY_BASE=feedback-redmine-local-secret-key-base-change-in-every-non-local-environment
FEEDBACK_REDMINE_GATEWAY_API_KEY=0123456789abcdef0123456789abcdef01234567
FEEDBACK_PARTICIPANT_SIGNING_KEY=feedback-participant-local-signing-key-change-me
FEEDBACK_PUBLIC_ORIGIN=http://localhost:5173

# SPA公開profileと、Composeが公開gatewayへ渡すenv-only profileで一致させる非secret設定。
FEEDBACK_REDMINE_ENABLED=true
FEEDBACK_REDMINE_PROFILE_ID=gis-local
FEEDBACK_REDMINE_GATEWAY_BASE_PATH=/internal/feedback-redmine/v1
FEEDBACK_REDMINE_PROFILE_DISPLAY_NAME=GIS Example Local Feedback
FEEDBACK_REDMINE_APPLICATION_KEY=gis-example
FEEDBACK_REDMINE_ENVIRONMENT_KEY=local
FEEDBACK_REDMINE_WORKSPACE_KEY=local-review
FEEDBACK_HOST_RELEASE=local
FEEDBACK_REDMINE_PERSPECTIVES_JSON=[{"code":"ux","label":"UI/UX"},{"code":"data","label":"データ"},{"code":"bug","label":"不具合"}]
FEEDBACK_REDMINE_CAPTURE_ENABLED=true
# devicePixelRatio=2の地図込みPNGを保存できるよう、SDK契約とRedmineの上限10 MiBへ揃える。
FEEDBACK_REDMINE_MAXIMUM_UPLOAD_BYTES=10485760
FEEDBACK_REDMINE_MAXIMUM_INLINE_PREVIEW_BYTES=10485760
FEEDBACK_REDMINE_MAXIMUM_DOWNLOAD_BYTES=10485760

# localhost Redmineを冪等bootstrapする固定ID。顧客Redmineでは実際のIDへ置換する。
FEEDBACK_REDMINE_BASE_URL=http://feedback-redmine:3000
FEEDBACK_REDMINE_PROJECT_ID=1
FEEDBACK_REDMINE_TRACKER_ID=4
FEEDBACK_REDMINE_IS_PRIVATE=false
FEEDBACK_REDMINE_DEFAULT_PRIORITY_ID=2
FEEDBACK_REDMINE_OPEN_STATUS_ID=1
FEEDBACK_REDMINE_CLOSED_STATUS_ID=5
FEEDBACK_REDMINE_CLOSED_STATUS_IDS_JSON=[5]
FEEDBACK_REDMINE_CUSTOM_FIELD_IDS_JSON={"threadId":1,"requestHash":2,"applicationKey":3,"environmentKey":4,"externalWorkspaceKey":5,"pageKey":6,"hostResourceKey":7,"perspectiveCode":8,"locator":9,"submittedById":10,"submittedByName":11}
FEEDBACK_REDMINE_SHOW_REDMINE_LINK=false

# ホスト側ポートが競合する場合のみ変更する
#FEEDBACK_REDMINE_HOST_PORT=3001
#FEEDBACK_REDMINE_GATEWAY_HOST_PORT=8082
