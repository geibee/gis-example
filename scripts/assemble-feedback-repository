#!/usr/bin/env bash
# allowlistだけから独立Feedback repository形状を組み立てる。
set -euo pipefail

ROOT=$(git rev-parse --show-toplevel)
output=""

usage() {
  echo "usage: scripts/assemble-feedback-repository --output <empty-directory>" >&2
  exit 2
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --output) [[ $# -ge 2 ]] || usage; output=$2; shift 2 ;;
    *) usage ;;
  esac
done
[[ -n "$output" ]] || usage

if [[ -e "$output" ]]; then
  [[ -d "$output" ]] || { echo "出力先はdirectoryで指定してください" >&2; exit 1; }
  [[ -z "$(find "$output" -mindepth 1 -maxdepth 1 -print -quit)" ]] || {
    echo "出力先は空である必要があります: $output" >&2
    exit 1
  }
else
  mkdir -p "$output"
fi
output=$(cd "$output" && pwd)

manifest=$(mktemp)
trap 'rm -f "$manifest"' EXIT
cd "$ROOT"

roots=(
  apps/feedback-service
  apps/feedback-admin
  apps/feedback-token-broker-reference
  apps/feedback-conformance-consumer
  contracts/feedback
  packages/feedback-core
  packages/feedback-react
  packages/feedback-maplibre
  packages/feedback-admin-react
  deploy
  tests/fixtures/feedback-sdk-vite
)

git ls-files --cached --others --exclude-standard -- "${roots[@]}" | sort -u >"$manifest"
while IFS= read -r source; do
  [[ -n "$source" ]] || continue
  # commit前の作業treeではindexに残る削除済みfileを列挙し得る。
  [[ -f "$source" ]] || continue
  case "$source" in
    */node_modules/* | */dist/* | */build/* | */.gradle/* | */.kotlin/*) continue ;;
    apps/feedback-service/src/main/kotlin/feedback/service/LegacyMigration*.kt) continue ;;
    apps/feedback-service/src/test/kotlin/feedback/service/integration/LegacyMigrationIntegrationTest.kt) continue ;;
    apps/feedback-service/src/main/resources/db/feedback-migration/*) continue ;;
    apps/feedback-service/src/main/resources/db/migration/V*.sql) continue ;;
  esac
  mkdir -p "$output/$(dirname "$source")"
  cp -p "$source" "$output/$source"
done <"$manifest"

root_files=(.gitignore .dockerignore .npmrc AGENTS.md README.md package.json package-lock.json)
for name in "${root_files[@]}"; do
  [[ -f "feedback-repository/$name" ]] || { echo "templateがありません: feedback-repository/$name" >&2; exit 1; }
  cp -p "feedback-repository/$name" "$output/$name"
done
cp -p .spectral.yaml "$output/.spectral.yaml"

mkdir -p "$output/docs" "$output/scripts" \
  "$output/apps/feedback-service/src/main/resources/db/migration"
cp -Rp feedback-repository/docs/. "$output/docs/"

scripts=(
  check-feedback-contracts.sh
  check-feedback-packages.sh
  check-feedback-conformance.sh
  generate-feedback-kotlin-contracts.mjs
  smoke-feedback-standalone.sh
  verify-feedback.sh
)
for name in "${scripts[@]}"; do cp -p "scripts/$name" "$output/scripts/$name"; done

# 現repositoryのversioned migrationは変更せず、抽出物だけをV1〜V5収束済みのclean V1にする。
baseline="$output/apps/feedback-service/src/main/resources/db/migration/V1__feedback_baseline.sql"
{
  echo "-- Feedback System独立DBの収束済みbaseline。旧consumer移行台帳は含めない。"
  sed -n '1,$p' apps/feedback-service/src/main/resources/db/migration/V1__feedback_baseline.sql
  sed -n '1,$p' apps/feedback-service/src/main/resources/db/migration/V2__export_delivery_admin.sql
  sed -n '4,13p' apps/feedback-service/src/main/resources/db/migration/V3__legacy_copy_journal.sql
  sed -n '1,$p' apps/feedback-service/src/main/resources/db/migration/V4__standalone_operational_guards.sql
  sed -n '1,$p' apps/feedback-service/src/main/resources/db/migration/V5__backup_and_connector_foundation.sql
} >"$baseline"

chmod +x "$output/apps/feedback-service/gradlew" "$output/scripts/"*.sh

for forbidden in apps/web apps/api packages/feedback-plugin infra/docker-compose.yml; do
  [[ ! -e "$output/$forbidden" ]] || { echo "禁止pathが抽出物へ混入しました: $forbidden" >&2; exit 1; }
done
if find "$output/apps/feedback-service" -type f \( -name '*LegacyMigration*' -o -name 'V3__legacy_copy_journal.sql' \) -print -quit | grep -q .; then
  echo "旧consumer移行実装が独立Serviceへ混入しました" >&2
  exit 1
fi
if rg -n -i 'postgis|gis_data|app\.(projects|users)|legacy_migration_(runs|entities)' "$baseline"; then
  echo "独立baselineへホストDBまたは旧移行台帳が混入しました" >&2
  exit 1
fi
node -e '
  const value = require(process.argv[1]);
  const forbidden = ["apps/web", "apps/api", "packages/feedback-plugin"];
  if (value.workspaces.some((workspace) => forbidden.includes(workspace))) process.exit(1);
' "$output/package.json" || { echo "root workspace allowlistが不正です" >&2; exit 1; }

echo "$output"
