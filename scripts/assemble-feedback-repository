#!/usr/bin/env bash
# allowlistだけから独立Feedback repository形状を組み立てる。
set -euo pipefail

ROOT=$(git rev-parse --show-toplevel)
output=""

usage() {
  echo "usage: scripts/assemble-feedback-repository --output <empty-directory> [--go-only]" >&2
  exit 2
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --output) [[ $# -ge 2 ]] || usage; output=$2; shift 2 ;;
    --go-only) shift ;; # Go-onlyが唯一の出力形状。既存automationとの互換option。
    *) usage ;;
  esac
done
[[ -n "$output" ]] || usage

if [[ -e "$output" ]]; then
  [[ -d "$output" ]] || { echo "出力先はdirectoryで指定してください" >&2; exit 1; }
  [[ -z "$(find "$output" -mindepth 1 -maxdepth 1 -print -quit)" ]] || {
    echo "出力先は空である必要があります: $output" >&2
    exit 1
  }
else
  mkdir -p "$output"
fi
output=$(cd "$output" && pwd)

manifest=$(mktemp)
trap 'rm -f "$manifest"' EXIT
cd "$ROOT"

roots=(
  apps/feedback-service-go
  apps/feedback-admin
  apps/feedback-token-broker-reference
  apps/feedback-conformance-consumer
  contracts/feedback
  packages/feedback-core
  packages/feedback-react
  packages/feedback-maplibre
  packages/feedback-admin-react
  deploy
  tests/fixtures/feedback-sdk-vite
)
git ls-files --cached --others --exclude-standard -- "${roots[@]}" | sort -u >"$manifest"
while IFS= read -r source; do
  [[ -n "$source" ]] || continue
  # commit前の作業treeではindexに残る削除済みfileを列挙し得る。
  [[ -f "$source" ]] || continue
  case "$source" in
    */node_modules/* | */dist/* | */build/* | */.gradle/* | */.kotlin/*) continue ;;
    contracts/feedback/kotlin/*) continue ;;
  esac
  mkdir -p "$output/$(dirname "$source")"
  cp -p "$source" "$output/$source"
done <"$manifest"

root_files=(.gitignore .dockerignore .npmrc AGENTS.md README.md package.json package-lock.json)
for name in "${root_files[@]}"; do
  [[ -f "feedback-repository/$name" ]] || { echo "templateがありません: feedback-repository/$name" >&2; exit 1; }
  cp -p "feedback-repository/$name" "$output/$name"
done
cp -p .spectral.yaml "$output/.spectral.yaml"

mkdir -p "$output/docs" "$output/scripts"
cp -Rp feedback-repository/docs/. "$output/docs/"

scripts=(
  build-feedback-go-release.sh
  check-feedback-contracts.sh
  check-feedback-packages.sh
  check-feedback-conformance.sh
  measure-feedback-runtime-memory.sh
  measure-feedback-canary.sh
  soak-feedback-go.sh
  smoke-feedback-standalone.sh
  verify-feedback.sh
  verify-feedback-go.sh
)
for name in "${scripts[@]}"; do cp -p "scripts/$name" "$output/scripts/$name"; done

# fresh installの収束済みclean V1をそのまま抽出する。
fresh_schema_fingerprint=de8ba8a564a39b533e92b37ebffd32bc1a6fbfb66addaad4f56dbd78cb934259
go_baseline="$output/apps/feedback-service-go/migrations/baseline/V1__feedback_baseline.sql"
[[ -f "$go_baseline" && "$(grep -c "$fresh_schema_fingerprint" "$go_baseline")" == "1" ]] || {
  echo "clean V1のschema fingerprint markerを生成できません" >&2
  exit 1
}
node - "$output/contracts/feedback/package.json" <<'NODE'
const fs = require("node:fs");
const path = process.argv[2];
const value = JSON.parse(fs.readFileSync(path, "utf8"));
value.files = value.files.filter((entry) => entry !== "kotlin");
value.scripts.generate = "openapi-typescript openapi.yaml -o src/generated.ts";
fs.writeFileSync(path, `${JSON.stringify(value, null, 2)}\n`);
NODE

chmod +x "$output/scripts/"*.sh

for forbidden in apps/web apps/api packages/feedback-plugin infra/docker-compose.yml; do
  [[ ! -e "$output/$forbidden" ]] || { echo "禁止pathが抽出物へ混入しました: $forbidden" >&2; exit 1; }
done
if find "$output" -type f \( -name '*.kt' -o -name '*.kts' -o -name 'gradlew' -o -name 'gradlew.bat' \) -print -quit | grep -q .; then
  echo "Go-only抽出物へKotlin/Gradle sourceが混入しました" >&2
  exit 1
fi
if rg -n 'apps/feedback-service/Dockerfile' "$output/deploy"; then
  echo "Go-only抽出物のComposeがKotlin imageを参照しています" >&2
  exit 1
fi
if rg -n -i 'postgis|gis_data|app\.(projects|users)|legacy_migration_(runs|entities)' "$go_baseline"; then
  echo "独立baselineへホストDBまたは旧移行台帳が混入しました" >&2
  exit 1
fi
node -e '
  const value = require(process.argv[1]);
  const forbidden = ["apps/web", "apps/api", "packages/feedback-plugin"];
  if (value.workspaces.some((workspace) => forbidden.includes(workspace))) process.exit(1);
' "$output/package.json" || { echo "root workspace allowlistが不正です" >&2; exit 1; }

echo "$output"
